{
  "name": "voicela",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@11.5.2",
  "scripts": {
    "dev": "pnpm tauri dev",
    "tauri": "pnpm --filter @voicela/app tauri",
    "web": "pnpm --filter @voicela/web",
    "build": "pnpm web build && pnpm tauri build",
    "start": "pnpm web start",
    "lint": "pnpm web lint",
    "speech:setup": "pnpm --filter @voicela/app speech:setup"
  }
}
