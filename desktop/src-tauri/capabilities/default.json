{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Local main window only; no shell, filesystem, opener or remote URL access",
  "windows": [
    "main"
  ],
  "permissions": [
    "core:default",
    "global-shortcut:allow-register",
    "global-shortcut:allow-unregister"
  ]
}
